{
  "schemaVersion": 1,
  "workload": {
    "id": "reference-notes-v1",
    "definition": "docs/PERFORMANCE.md#reference-workload",
    "samplePolicy": {
      "warmupRuns": 3,
      "measuredRuns": 10
    }
  },
  "metrics": {
    "coldStartMs": {
      "unit": "ms",
      "collection": "hosted-native",
      "statistic": "median",
      "minimumSamples": 10,
      "maxRegressionPercent": 20,
      "description": "Process spawn to the benchmark's first-present marker"
    },
    "idleRssBytes": {
      "unit": "bytes",
      "collection": "hosted-native",
      "statistic": "median",
      "minimumSamples": 10,
      "maxRegressionPercent": 20,
      "description": "Resident set after the idle settle window"
    },
    "artifactBytes": {
      "unit": "bytes",
      "collection": "deterministic-artifact",
      "statistic": "max",
      "minimumSamples": 1,
      "maxRegressionPercent": 5,
      "description": "Regular-file bytes in the unsigned distribution artifact"
    },
    "tickMs": {
      "unit": "ms",
      "collection": "hosted-native",
      "statistic": "p95",
      "minimumSamples": 100,
      "maxRegressionPercent": 15,
      "description": "Full measured UI tick duration"
    },
    "layoutMs": {
      "unit": "ms",
      "collection": "hosted-native",
      "statistic": "p95",
      "minimumSamples": 100,
      "maxRegressionPercent": 15,
      "description": "Layout phase duration"
    },
    "paintMs": {
      "unit": "ms",
      "collection": "hosted-native",
      "statistic": "p95",
      "minimumSamples": 100,
      "maxRegressionPercent": 15,
      "description": "Paint phase duration"
    }
  },
  "platforms": {
    "darwin-arm64": {
      "runner": "macos-15",
      "baselines": {
        "coldStartMs": {
          "status": "pending",
          "reason": "Awaiting an isolated hosted macOS first-present capture"
        },
        "idleRssBytes": {
          "status": "pending",
          "reason": "Awaiting an isolated hosted macOS RSS capture"
        },
        "artifactBytes": {
          "status": "pending",
          "reason": "Awaiting the G6-01 clean consumer artifact"
        },
        "tickMs": {
          "status": "pending",
          "reason": "Awaiting hosted runtime frame metrics"
        },
        "layoutMs": {
          "status": "pending",
          "reason": "Awaiting hosted runtime frame metrics"
        },
        "paintMs": {
          "status": "pending",
          "reason": "Awaiting hosted runtime frame metrics"
        }
      }
    },
    "win32-x64": {
      "runner": "windows-2022",
      "baselines": {
        "coldStartMs": {
          "status": "pending",
          "reason": "Awaiting an isolated hosted Windows first-present capture"
        },
        "idleRssBytes": {
