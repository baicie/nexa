{
  "reasons": {
    "orchestrator": "The root package only orchestrates checks owned by workspace projects.",
    "no-package-tests": "No package-level test suite is defined yet; the gap remains visible in this matrix.",
    "source-package": "This source package is consumed directly and has no standalone build artifact.",
    "native-build-gate": "Native-library builds are owned by the dedicated FFI verification gate.",
    "shared-lint": "This project is covered by the repository-wide root lint command."
  },
  "projects": [
    {
      "path": ".",
      "checks": {
        "typecheck": { "skip": "orchestrator" },
        "test": { "script": "test:workspace" },
