{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa-ui.dev/schema/common-v1.json",
  "title": "Nexa Common Protocol Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "namespace",
    "featureNamespace",
    "protocol",
    "abi",
    "resultTransport",
    "resultEnvelope",
    "handleValidation",
    "handleTransport",
    "features",
    "handleKinds",
    "types",
    "commands",
    "ffiFunctions",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "namespace": { "type": "string", "const": "common" },
    "featureNamespace": { "type": "string", "const": "transport" },
    "protocol": { "$ref": "#/$defs/protocolVersion" },
    "abi": { "$ref": "#/$defs/abiVersion" },
    "resultTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "encoding", "perryReturn", "envelope"],
      "properties": {
        "version": { "$ref": "#/$defs/u32" },
        "encoding": { "const": "json_utf8" },
        "perryReturn": { "const": "string" },
        "envelope": { "const": "nexa_result_v1" }
      }
    },
    "resultEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tagField",
        "successTag",
        "valueField",
        "failureTag",
        "errorField",
        "errorType",
        "unitValue",
        "rejectUnknownFields"
      ],
      "properties": {
        "tagField": { "const": "ok" },
        "successTag": { "const": true },
        "valueField": { "const": "value" },
        "failureTag": { "const": false },
        "errorField": { "const": "error" },
        "errorType": { "const": "common.NexaError" },
        "unitValue": { "type": "null" },
        "rejectUnknownFields": { "const": true }
      }
    },
    "handleValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotMinimum", "slotMaximum", "generationMinimum", "generationMaximum"],
      "properties": {
        "slotMinimum": { "type": "integer", "const": 0 },
        "slotMaximum": { "type": "integer", "const": 4294967295 },
        "generationMinimum": { "type": "integer", "const": 1 },
        "generationMaximum": { "type": "integer", "const": 4294967295 }
      }
    },
    "handleTransport": { "$ref": "#/$defs/handleTransport" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    },
    "handleKinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/idEntry" }
    },
    "types": {
      "type": "array",
      "items": { "$ref": "#/$defs/typeDefinition" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "ffiFunctions": {
      "type": "array",
      "items": { "$ref": "#/$defs/ffiFunction" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "$defs": {
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "protocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "patch"],
      "properties": {
        "major": { "$ref": "#/$defs/u32" },
        "minor": { "$ref": "#/$defs/u32" },
        "patch": { "$ref": "#/$defs/u32" }
      }
    },
    "abiVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "$ref": "#/$defs/u32" },
        "minor": { "$ref": "#/$defs/u32" }
      }
    },
    "lifecycleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "$ref": "#/$defs/u32" },
        "minor": { "$ref": "#/$defs/u32" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "introduced", "deprecated", "removed", "replacement"],
      "properties": {
        "status": { "enum": ["active", "reserved", "tombstone"] },
        "introduced": { "$ref": "#/$defs/lifecycleVersion" },
        "deprecated": {
          "oneOf": [{ "$ref": "#/$defs/lifecycleVersion" }, { "type": "null" }]
        },
        "removed": {
          "oneOf": [{ "$ref": "#/$defs/lifecycleVersion" }, { "type": "null" }]
        },
        "replacement": {
          "type": ["string", "null"],
          "pattern": "^(transport|common|ui|system)\\.[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bit", "name", "lifecycle"],
      "properties": {
        "bit": { "type": "integer", "minimum": 0, "maximum": 63 },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "idEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "lifecycle"],
      "properties": {
        "id": { "$ref": "#/$defs/u16" },
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "typeName": {
      "type": "string",
      "pattern": "^((common|ui|system)\\.)?[A-Za-z][A-Za-z0-9]*$"
    },
    "typeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "optional"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "type": { "$ref": "#/$defs/typeName" },
        "handleKind": {
          "type": "string",
          "pattern": "^common\\.[A-Z][A-Za-z0-9]*$"
        },
        "optional": { "type": "boolean" }
      }
    },
    "recordType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "fields", "lifecycle"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "const": "record" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/typeField" }
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "enumType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "values", "lifecycle"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "const": "enum" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "mapType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "valueTypes", "lifecycle"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "const": "map" },
        "valueTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/typeName" }
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "listType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "elementType", "lifecycle"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "const": "list" },
        "elementType": { "$ref": "#/$defs/typeName" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "typeDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/recordType" },
        { "$ref": "#/$defs/enumType" },
        { "$ref": "#/$defs/mapType" },
        { "$ref": "#/$defs/listType" }
      ]
    },
    "commandParam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "optional"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "type": { "$ref": "#/$defs/typeName" },
        "handleKind": {
          "type": "string",
          "pattern": "^common\\.[A-Z][A-Za-z0-9]*$"
        },
        "optional": { "type": "boolean" }
      }
    },
    "commandReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "result"],
      "properties": {
        "type": { "$ref": "#/$defs/typeName" },
        "handleKind": {
          "type": "string",
          "pattern": "^common\\.[A-Z][A-Za-z0-9]*$"
        },
        "result": { "const": true }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "params", "returns", "requiresFeatures", "lifecycle"],
      "properties": {
        "id": { "$ref": "#/$defs/u16" },
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandParam" }
        },
        "returns": { "$ref": "#/$defs/commandReturn" },
        "requiresFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(transport|ui|system)\\.[a-z][a-z0-9_]*$"
          }
        },
        "requiredPermissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^system\\.[A-Z][A-Za-z0-9]*$"
          }
        },
        "createsTaskKind": {
          "type": ["string", "null"],
          "pattern": "^system\\.[A-Z][A-Za-z0-9]*$"
        },
        "createsResourceKind": {
          "type": ["string", "null"],
          "pattern": "^system\\.[A-Z][A-Za-z0-9]*$"
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "ffiParam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "mapping"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "type": {
          "enum": ["string", "u32", "u64", "i32", "f64", "ptr", "jsvalue"]
        },
        "mapping": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9_]*)+$"
        }
      }
    },
    "ffiFixedMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "value"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "value": { "type": ["string", "number", "boolean"] }
      }
    },
    "ffiFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abiIndex",
        "library",
        "name",
        "command",
        "params",
        "fixedMappings",
        "returns",
        "resultCodec",
        "status",
        "lifecycle"
      ],
      "properties": {
        "abiIndex": { "$ref": "#/$defs/u32" },
        "library": { "enum": ["ui", "system"] },
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "command": {
          "type": "string",
          "pattern": "^(common|ui|system)\\.[A-Z][A-Za-z0-9]*$"
        },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/ffiParam" }
        },
        "fixedMappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/ffiFixedMapping" }
        },
        "returns": {
          "enum": [
            "string",
            "promise<string>",
            "u32",
            "u64",
            "i32",
            "f64",
            "ptr",
            "jsvalue",
            "void"
          ]
        },
        "resultCodec": { "enum": ["nexa_result_json_v1", "legacy_raw", "legacy_sentinel"] },
        "status": { "enum": ["v1", "legacy"] },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "code", "name", "retryable", "severity", "contextKeys", "lifecycle"],
      "properties": {
        "domain": { "enum": ["protocol", "ui", "system"] },
        "code": { "$ref": "#/$defs/u32" },
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "retryable": { "type": "boolean" },
        "severity": {
          "enum": ["ProtocolViolation", "RecoverableOperation", "FrameFailure", "FatalRuntime"]
        },
        "contextKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "handleTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalType",
        "requiredFeature",
        "wireToken",
        "input",
        "optionalInput",
        "result"
      ],
      "properties": {
        "logicalType": { "const": "HandleRef" },
        "requiredFeature": { "const": "transport.handle_ref" },
        "wireToken": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "prefix",
            "separator",
            "slotHexWidth",
            "generationHexWidth",
            "hexCase"
          ],
          "properties": {
            "version": { "type": "integer", "const": 1 },
            "prefix": { "const": "h1" },
            "separator": { "const": "/" },
            "slotHexWidth": { "type": "integer", "const": 8 },
            "generationHexWidth": { "type": "integer", "const": 8 },
            "hexCase": { "const": "lower" }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perryTypes", "parts"],
          "properties": {
            "perryTypes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [{ "const": "u32" }, { "const": "u32" }],
              "items": false
            },
            "parts": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [{ "const": "slot" }, { "const": "generation" }],
              "items": false
            }
          }
        },
        "optionalInput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perryTypes", "parts", "absent"],
          "properties": {
            "perryTypes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [{ "const": "u32" }, { "const": "u32" }, { "const": "u32" }],
              "items": false
            },
            "parts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "const": "presence" },
                { "const": "slot" },
                { "const": "generation" }
              ],
              "items": false
            },
            "absent": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [{ "const": 0 }, { "const": 0 }, { "const": 0 }],
              "items": false
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perryType", "codec", "successValueCodec"],
          "properties": {
            "perryType": { "const": "string" },
            "codec": { "const": "nexa_result_json_v1" },
            "successValueCodec": { "const": "handle_token_v1" }
          }
        }
      }
    }
  }
}
