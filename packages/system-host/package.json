{
  "name": "@nexa/system-host",
  "version": "0.1.0",
  "type": "module",
  "description": "Perry native library exposing the Nexa System Host Protocol (ADR-005)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "perry": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nexa/protocol": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../tools/build-release-packages.mjs --package @nexa/system-host",
    "test": "node --test ../../tools/system-result-contract.test.mjs"
  },
  "perry": {
    "nativeLibrary": {
      "abiVersion": "0.5",
      "functions": [
        {
          "name": "js_nexa_clipboard_read_text",
          "params": [],
          "returns": "string"
        },
        {
          "name": "js_nexa_clipboard_write_text",
          "params": [
            "string"
          ],
          "returns": "i32"
        },
        {
          "name": "js_nexa_clipboard_read_text_v1",
          "params": [],
          "returns": "string"
        },
        {
          "name": "js_nexa_clipboard_write_text_v1",
          "params": [
            "string"
          ],
          "returns": "string"
        },
        {
          "name": "js_nexa_cancel_task_v1",
          "params": [
            "u32",
            "u32"
          ],
          "returns": "string"
        },
        {
          "name": "js_nexa_read_text_file_v1",
          "params": [
            "string"
          ],
          "returns": "string"
        },
        {
          "name": "js_nexa_write_text_file_v1",
          "params": [
            "string",
            "string"
          ],
          "returns": "string"
        },
        {
          "name": "js_nexa_await_task_v1",
          "params": [
            "u32",
            "u32"
          ],
          "returns": "promise<string>"
        },
        {
          "name": "js_nexa_open_file_dialog_v1",
          "params": [
            "string",
            "string",
            "string"
          ],
          "returns": "string"
        },
        {
          "name": "js_nexa_save_file_dialog_v1",
          "params": [
            "string",
            "string",
            "string"
          ],
          "returns": "string"
        }
      ],
      "targets": {
        "macos": {
          "crate": "dist/native/repo/packages/system-host",
          "lib": "libperry_ext_nexa_system_host.a",
          "cargo_features": [],
          "libs": [
            "c++"
          ],
          "frameworks": [
            "AppKit",
            "Foundation"
          ]
        },
        "linux": {
          "crate": "dist/native/repo/packages/system-host",
          "lib": "libperry_ext_nexa_system_host.a",
          "cargo_features": [],
          "libs": [
            "wayland-client"
          ]
        },
        "windows": {
          "crate": "dist/native/repo/packages/system-host",
          "lib": "perry_ext_nexa_system_host.lib",
          "cargo_features": []
        }
      }
    }
  }
}
