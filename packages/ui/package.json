{
  "name": "@nexa/ui",
  "version": "0.1.0",
  "description": "Minimal TSX runtime + primitives for Nexa UI (Slice 3)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "dependencies": {
    "@nexa/nui-host": "workspace:*",
    "@nexa/protocol": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../tools/build-release-packages.mjs --package @nexa/ui",
    "test": "node --test --experimental-strip-types src/*.test.ts src/**/*.test.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
