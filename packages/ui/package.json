{
  "name": "@nexa/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal TSX runtime + primitives for Nexa UI (Slice 3)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts"
  },
  "dependencies": {
    "@nexa/nui-host": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "files": [
    "src",
    "dist"
  ]
}
