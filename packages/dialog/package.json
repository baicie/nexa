{
  "name": "@nexa/dialog",
  "version": "0.1.0",
  "description": "Typed asynchronous native file dialogs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nexa/system-host": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
