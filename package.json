{
  "name": "nexa-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Native UI toolkit for TypeScript/TSX via Perry AOT — no WebView, no Chromium",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "node tools/workspace-checks.mjs build",
    "typecheck": "node tools/workspace-checks.mjs typecheck",
    "test": "node tools/workspace-checks.mjs test",
    "lint": "node tools/workspace-checks.mjs lint",
    "lint:source": "node tools/lint.mjs",
    "test:workspace": "node --test tools/workspace-checks.test.mjs",
    "workspace:validate": "node tools/workspace-checks.mjs validate",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "rust:check": "cargo check --workspace",
    "rust:test": "cargo test --workspace",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@perryts/perry": "0.5.1220",
    "oxlint": "1.77.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "yaml": "2.9.0"
  },
  "perry": {
    "allow": {
      "nativeLibrary": [
        "@nexa/nui-host",
        "@nexa/*"
      ]
    }
  }
}
