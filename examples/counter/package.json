{
  "name": "@nexa/example-counter",
  "version": "0.1.0",
  "private": true,
  "description": "Slice 3 acceptance: Minimal TSX Counter",
  "type": "module",
  "dependencies": {
    "@nexa/ui": "workspace:*",
    "@nexa/nui-host": "workspace:*"
  },
  "scripts": {
    "build": "perry compile main.tsx -o counter",
    "smoke": "node ../../tools/perry-smoke.mjs",
    "start": "perry compile main.tsx -o counter && ./counter",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "perry": {
    "allow": {
      "nativeLibrary": [
        "@nexa/nui-host",
        "@nexa/ui"
      ]
    }
  }
}
